<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BaseMeleeWeapon_Sharp">
		<defName>Gungnir</defName>
		<label>Gungnir</label>
		<description>A precious relic found in the far reaches of the Rim, fashioned into the head of a harpoon. It emanates a constant, ambient droning that amplifies with every strike and is rather uncomfortable to wield. Much like its Coreworld mythological namesake, Gungnir will always hit its mark, piercing and weaving through anything in its way to impale it.</description>
		<techLevel>Archotech</techLevel>
		<graphicData>
			<texPath>Weapons/Gungnir</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.6, 1.6)</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>5000</MarketValue>
			<Mass>3</Mass>
			<Beauty>5</Beauty>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
		<useHitPoints>false</useHitPoints>
		<smeltable>false</smeltable>
		<recipeMaker IsNull="True"/>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
		<burnableByRecipe>false</burnableByRecipe>
		<tradeTags Inherit="False" />
		<tradeability>None</tradeability>
		<tools>
			<li>
				<label>shaft</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>21</power>
				<cooldownTime>1.6</cooldownTime>
				<armorPenetration>0.3</armorPenetration>
			</li>
			<li>
				<label>speartip</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>48</power>
				<cooldownTime>1.6</cooldownTime>
				<armorPenetration>1.6</armorPenetration>
				<chanceFactor>2</chanceFactor>
			</li>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>46</power>
				<cooldownTime>1.6</cooldownTime>
				<armorPenetration>1.55</armorPenetration>
			</li>
		</tools>
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_EquippableAbility">
				<abilityDef>Gungnir_Throw</abilityDef>
			</li>
			<li Class="CompProperties_Styleable"/>
			<li Class="SingularityFramework.Relics.CompProperties_RelicAptitude">
				<rejectsUnworthy>false</rejectsUnworthy>
				<fullAptitudeRequirements>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Skill">
						<skill>Melee</skill>
						<minimum>18</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Stat">
						<stat>MoveSpeed</stat>
						<minimum>5.5</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Capacity">
						<capacity>Manipulation</capacity>
						<minimum>1.25</minimum>
					</li>
				</fullAptitudeRequirements>
				<partialAptitudeRequirements>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Skill">
						<skill>Melee</skill>
						<minimum>10</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Stat">
						<stat>MoveSpeed</stat>
						<minimum>4.6</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Capacity">
						<capacity>Manipulation</capacity>
						<minimum>0.9</minimum>
					</li>
				</partialAptitudeRequirements>
			</li>
		</comps>
		<equippedAngleOffset>-45</equippedAngleOffset>
	</ThingDef>

	<ThingDef>
		<defName>Gungnir_Flight</defName>
		<label>Gungnir</label>
		<thingClass>Gungnir.GungnirFlight</thingClass>
		<category>Projectile</category>
		<tickerType>Normal</tickerType>
		<altitudeLayer>Projectile</altitudeLayer>
		<drawerType>RealtimeOnly</drawerType>
		<useHitPoints>false</useHitPoints>
		<neverMultiSelect>true</neverMultiSelect>
	</ThingDef>
</Defs>
