  <SoundDef>
    <defName>Gungnir_Throw</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
			 <clipPath>Gungnir_Throw</clipPath>
          </li>
        </grains>
        <volumeRange>45~50</volumeRange>
        <pitchRange>0.97~1.03</pitchRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_CameraAltitude" />
            <outParam Class="SoundParamTarget_Volume" />
            <curve>
              <points>
                <li>(15, 1)</li>
                <li>(40, 0.4)</li>
                <li>(65, 0)</li>
              </points>
            </curve>
          </li>
        </paramMappings>
      </li>
    </subSounds>
  </SoundDef>

