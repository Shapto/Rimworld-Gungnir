<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef>
		<defName>Gungnir_Droning</defName>
		<label>nested harpoon</label>
		<description>This person has been impaled by Gungnir. Successive strikes will amplify the harpoon's droning force.</description>
		<hediffClass>Gungnir.Hediff_GungnirDroning</hediffClass>
		<defaultLabelColor>(0.95, 0.8, 0.2)</defaultLabelColor>
		<isBad>true</isBad>
		<initialSeverity>0</initialSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<statFactors>
					<MoveSpeed>0.85</MoveSpeed>
				</statFactors>
			</li>
		</stages>
		<renderNodeProperties>
  			<li>
				<nodeClass>Gungnir.PawnRenderNode_LodgedGungnir</nodeClass>
				<workerClass>Gungnir.PawnRenderNodeWorker_LodgedGungnir</workerClass>
				<texPath>Weapons/Gungnir</texPath>
				<parentTagDef>Body</parentTagDef>
				<overrideMeshSize>(1.6, 1.6)</overrideMeshSize>
				<baseLayer>-10</baseLayer>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
 		 	</li>
		</renderNodeProperties>
	</HediffDef>

	<HediffDef>
		<defName>Gungnir_OpenHand</defName>
		<label>open hand</label>
		<description>Gungnir has left this person's hand, though they can still feel its droning. The harpoon will return on their behest.</description>
		<hediffClass>Gungnir.Hediff_GungnirOpenHand</hediffClass>
		<isBad>false</isBad>
		<defaultLabelColor>(0.95, 0.8, 0.2)</defaultLabelColor>
		<comps>
			<li Class="HediffCompProperties_GiveAbility">
				<abilityDef>Gungnir_Recall</abilityDef>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>Gungnir_Reverberation</defName>
		<label>reverberation</label>
		<description>A debilitating sting reverberates through the arm's corpus, caused by catching Gungnir mid-flight.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.95, 0.8, 0.2)</defaultLabelColor>
		<isBad>true</isBad>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>1800</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<partEfficiencyOffset>-0.15</partEfficiencyOffset>
			</li>
		</stages>
	</HediffDef>
</Defs>
