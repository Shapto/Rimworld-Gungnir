<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef>
		<defName>Gungnir_Droning</defName>
		<label>nested harpoon</label>
		<description>Those impaled by Gungnir are pulverized as successive strikes amplify its droning force.</description>
		<hediffClass>Gungnir.Hediff_GungnirDroning</hediffClass>
		<defaultLabelColor>(0.95, 0.8, 0.2)</defaultLabelColor>
		<isBad>true</isBad>
		<initialSeverity>0</initialSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<statFactors>
					<MoveSpeed>0.85</MoveSpeed>
				</statFactors>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>Gungnir_OpenHand</defName>
		<label>open hand</label>
		<description>Gungnir has left this hand. It will return to it, whether or not the hand can stop it.</description>
		<hediffClass>Gungnir.Hediff_GungnirOpenHand</hediffClass>
		<isBad>false</isBad>
		<defaultLabelColor>(0.95, 0.8, 0.2)</defaultLabelColor>
		<comps>
			<li Class="HediffCompProperties_GiveAbility">
				<abilityDef>Gungnir_Recall</abilityDef>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>Gungnir_Reverberation</defName>
		<label>reverberation</label>
		<description>This arm stopped Gungnir mid-flight and is still reeling from the impact.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.95, 0.8, 0.2)</defaultLabelColor>
		<isBad>true</isBad>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>1800</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<partEfficiencyOffset>-0.15</partEfficiencyOffset>
			</li>
		</stages>
	</HediffDef>
</Defs>